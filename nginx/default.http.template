server {
    listen 80 default_server;
    server_name ${APP_HOSTNAME};

    root /usr/share/nginx/html;
    index index.html;

    location ~ /\. {
        return 404;
    }

    location ~* \.(php|asp|aspx|cgi|pl|env|sh|bash|sql|bak|backup)$ {
        return 404;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|map|txt)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
